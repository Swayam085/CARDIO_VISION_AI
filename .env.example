# ============================================================
# CARDIOVISION AI — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Backend ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
BACKEND_LOG_LEVEL=info
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=CardioVision AI
VITE_APP_VERSION=0.1.0

# ── ML Pipeline ──────────────────────────────────────────────
# UCI Dataset source (do not change — official dataset)
UCI_DATASET_URL=https://archive.ics.uci.edu/dataset/411/extention+of+z
UCI_DATASET_ID=411
UCI_DATASET_NAME=Extension of Z-Alizadeh Sani Dataset

# Path to downloaded/processed data
ML_DATA_DIR=ml/data
ML_ARTIFACTS_DIR=ml/artifacts
BACKEND_ARTIFACTS_DIR=backend/artifacts

# Random seed for reproducibility
RANDOM_SEED=42
TEST_SIZE=0.2
CV_FOLDS=5

# ── 3D Anatomy ───────────────────────────────────────────────
# BodyParts3D source (primary anatomical reference)
ANATOMY_SOURCE_URL=https://lifesciencedb.jp/bp3d
ANATOMY_SOURCE_NAME=BodyParts3D / Anatomography by DBCLS
ANATOMY_FILE_FORMAT=GLB/GLTF (preferred)

# Path to 3D model assets in public/models/
VITE_MODELS_PATH=/models
